{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "snehealthclinics",

  "main": "./sne-health-backend/server.js",

  "compatibility_date": "2026-06-09",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "compatibility_flags": [
    "nodejs_compat"
  ]
}